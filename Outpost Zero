  // сущности, по глубине
  const live=new Set(), ents=[];
  for(const a of W_.an){live.add('a'+a.id);const e=ease('a'+a.id,a.x,a.y);ents.push({y:e.y,f:()=>{
    const A=ANI[a.k],cx=ox+(e.x+.5)*z,by=oy+(e.y+.95)*z;
    ctx.fillStyle='rgba(0,0,0,.25)';ctx.beginPath();ctx.ellipse(cx,by-z*.02,z*A.h*.4,z*.09,0,0,7);ctx.fill();
    if(!spFit(A.s,cx,by,z*A.h,a.fl===1)){ctx.fillStyle='#c9b79a';ctx.beginPath();ctx.arc(cx,by-z*.3,z*.25,0,7);ctx.fill();}
    if(a.h){ctx.strokeStyle='#ff6a4d';ctx.lineWidth=2;const cy=by-z*A.h*.5,rr=Math.max(z*.35,z*A.h*.55);ctx.beginPath();ctx.arc(cx,cy,rr,0,7);ctx.moveTo(cx-rr-3,cy);ctx.lineTo(cx-rr*.4,cy);ctx.moveTo(cx+rr*.4,cy);ctx.lineTo(cx+rr+3,cy);ctx.moveTo(cx,cy-rr-3);ctx.lineTo(cx,cy-rr*.4);ctx.moveTo(cx,cy+rr*.4);ctx.lineTo(cx,cy+rr+3);ctx.stroke();}
  }});}
  for(const c of W_.cols){live.add(c.id);const e=ease(c.id,c.x,c.y);ents.push({y:e.y,f:()=>{
    const sx=ox+(e.x+.5)*z, sy=oy+(e.y+.5)*z, nm='c'+(c.col%16), hh=z*1.3;
    ctx.fillStyle='rgba(0,0,0,.28)';ctx.beginPath();ctx.ellipse(sx,sy+z*.42,z*.3,z*.1,0,0,7);ctx.fill();
    ctx.strokeStyle=PCOL[c.col%8];ctx.lineWidth=2;ctx.beginPath();ctx.ellipse(sx,sy+z*.42,z*.34,z*.12,0,0,7);ctx.stroke();
    if(selected===c.id){ctx.strokeStyle='#fff';ctx.lineWidth=2.5;ctx.beginPath();ctx.ellipse(sx,sy+z*.42,z*.46,z*.17,0,0,7);ctx.stroke();}
    const m=SPR[nm]; const w=m?hh*m[2]/m[3]:hh*.5;
    if(c.sl&&m){ctx.save();ctx.translate(sx,sy+z*.15);ctx.rotate(-Math.PI/2);sp(nm,-w/2,-hh*.5,w,hh);ctx.restore();ctx.fillStyle='#bfe0ff';ctx.font='700 '+Math.round(z*.4)+'px Barlow Condensed, sans-serif';ctx.textAlign='center';ctx.fillText('z',sx+z*.3,sy-z*.2);}
    else if(!sp(nm,sx-w/2,sy+z*.45-hh,w,hh)){ctx.fillStyle=PCOL[c.col%8];ctx.beginPath();ctx.arc(sx,sy,z*.32,0,7);ctx.fill();}
    if(!c.sl)drawGun(c.wp,sx,sy,z,c.fl);
    if(c.hp<95){ctx.fillStyle='#000a';ctx.fillRect(sx-z*.3,sy-hh*.62,z*.6,3);ctx.fillStyle='#e5634f';ctx.fillRect(sx-z*.3,sy-hh*.62,z*.6*clamp(c.hp,0,100)/100,3);}
    if(z>=14){ctx.fillStyle='#fff';ctx.strokeStyle='rgba(0,0,0,.7)';ctx.lineWidth=3;ctx.font='600 '+Math.max(10,Math.round(z*.3))+'px Barlow, sans-serif';ctx.textAlign='center';ctx.textBaseline='alphabetic';ctx.strokeText(c.n,sx,sy-hh*.66);ctx.fillText(c.n,sx,sy-hh*.66);}
  }});}
  for(const r of W_.raid){live.add(r.id);const e=ease(r.id,r.x,r.y);ents.push({y:e.y,f:()=>{
    const E=ENM[r.t]||ENM.raider, sx=ox+(e.x+.5)*z, sy=oy+(e.y+.5)*z, big=r.t==='brute'?1.15:1;
    ctx.fillStyle='rgba(0,0,0,.3)';ctx.beginPath();ctx.ellipse(sx,sy+z*.42,z*(E.s?E.h*.42:.3)*big,z*.1,0,0,7);ctx.fill();
    ctx.strokeStyle='#ff4a36';ctx.lineWidth=2.5;ctx.beginPath();ctx.ellipse(sx,sy+z*.42,z*(E.s?E.h*.46:.36)*big,z*.13,0,0,7);ctx.stroke();
