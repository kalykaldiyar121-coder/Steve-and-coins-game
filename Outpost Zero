/* ---------- генератор случайных чисел внутри мира ---------- */
function rnd(){
  world.rs=(world.rs+0x6D2B79F5)|0; let t=world.rs;
  t=Math.imul(t^(t>>>15),t|1); t^=t+Math.imul(t^(t>>>7),t|61);
  return ((t^(t>>>14))>>>0)/4294967296;
}
const ri=(a,b)=>a+Math.floor(rnd()*(b-a+1));
const I=(x,y)=>y*W+x, X=i=>i%W, Y=i=>(i/W)|0;
const inb=(x,y)=>x>=0&&y>=0&&x<W&&y<H;
const cheb=(a,b)=>Math.max(Math.abs(a.x-b.x),Math.abs(a.y-b.y));
const clamp=(v,a,b)=>Math.max(a,Math.min(b,v));

/* ---------- создание мира ---------- */
function genWorld(seed){
  world={v:1,tick:600,speed:1,rs:seed|0,T:new Array(N).fill('.'),S:new Array(N).fill(' '),
    res:{wood:50,stone:10,food:40},D:{},B:{},G:{},HP:{},cols:[],raid:[],an:[],stock:{pistol:2,rifle:0},Q:{pistol:0,rifle:0},nextBeast:Math.floor(TPD*2.6),log:[],ca:[],nid:1,
    nextRaid:Math.floor(TPD*3.5),nextWand:Math.floor(TPD*1.6),inRaid:false,over:false};
  const cx=W/2,cy=H/2;
  const blob=(bx,by,r,ch,dens)=>{
    for(let dy=-r;dy<=r;dy++)for(let dx=-r;dx<=r;dx++){
      const x=bx+dx,y=by+dy; if(!inb(x,y))continue;
      if(dx*dx+dy*dy<=r*r*(0.55+0.45*rnd())&&rnd()<dens)world.T[I(x,y)]=ch;
    }};
  const far=(min)=>{for(let k=0;k<40;k++){const x=ri(2,W-3),y=ri(2,H-3);if(Math.hypot(x-cx,y-cy)>=min)return[x,y];}return[3,3];};
  for(let k=0;k<45;k++){blob(ri(0,W-1),ri(0,H-1),ri(1,3),',',1);}
  for(let k=0;k<6;k++){const[x,y]=far(13);blob(x,y,ri(3,6),'#',1);}
  for(let k=0;k<2;k++){const[x,y]=far(11);blob(x,y,ri(3,5),'~',1);}
  for(let k=0;k<9;k++){const[x,y]=far(7);blob(x,y,ri(3,6),'t',0.78);}
  for(let k=0;k<30;k++){const x=Math.round(cx+(rnd()-.5)*30),y=Math.round(cy+(rnd()-.5)*20);
    if(inb(x,y)&&(world.T[I(x,y)]==='.'||world.T[I(x,y)]===','))world.T[I(x,y)]='b';}
  for(let y=0;y<H;y++)for(let x=0;x<W;x++){ if(Math.hypot(x-cx,y-cy)<=5)world.T[I(x,y)]=(rnd()<.2)?',':'.'; }
  for(let k=0;k<4;k++)addColonist(Math.round(cx)+(k%2)*2-1,Math.round(cy)+Math.floor(k/2)*2-1);
  for(let k=0;k<14;k++){for(let a=0;a<30;a++){const x=ri(1,W-2),y=ri(1,H-2); if(Math.hypot(x-cx,y-cy)>8&&(world.T[I(x,y)]==='.'||world.T[I(x,y)]===',')){addAnimal(x,y);break;}}}
  logAdd('Четверо колонистов разбили лагерь. Добудьте дерево, постройте кровати и грядки.');
}
function addAnimal(x,y){world.an.push({id:world.nid++,x,y,k:ri(0,ANI.length-1),h:0,mt:0,fl:0});}
function addColonist(x,y,at){
  const used=new Set(world.cols.map(c=>c.n)); let pool=NAMES.filter(n=>!used.has(n)); if(!pool.length)pool=NAMES;
  const n=pool[ri(0,pool.length-1)];
  const c={id:world.nid++,n,x,y,hn:80,rs:80,md:60,hp:100,job:null,mt:0,cd:0,sl:false,mb:0,gr:0,fed:0,brk:0,col:world.nid%16,wp:'fist',fl:0,bad:{}};
  world.cols.push(c); return c;
}
