  }
  // проход 2: деревья, кусты, объёмные постройки (сверху вниз)
  for(let y=y0;y<=Math.min(H-1,y1+2);y++)for(let x=Math.max(0,x0-1);x<=Math.min(W-1,x1+1);x++){
    const i=y*W+x,t=W_.T[i],s=W_.S[i],hh=hash(i),sx=Math.round(ox+x*z),sy=Math.round(oy+y*z),cx=sx+z/2;
