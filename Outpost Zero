<style>
/* Layout: top status bar, map viewport with a collapsible side panel, bottom order toolbar. Single dark look, the map is the page. */
:root{
  --bg:#12171a; --panel:#1b2226; --panel2:#252e33; --line:#35424a;
  --fg:#e7eae4; --mute:#94a19c; --accent:#e3a645; --good:#7cc47f; --bad:#e5634f; --info:#6fb1e0;
  --font-body:'Barlow',system-ui,-apple-system,'Segoe UI',sans-serif;
  --font-head:'Barlow Condensed','Arial Narrow',system-ui,sans-serif;
  color-scheme:dark;
}
*{box-sizing:border-box}
html,body{height:100%}
body{margin:0;background:var(--bg);color:var(--fg);font:14px/1.4 var(--font-body);overflow:hidden;user-select:none;-webkit-user-select:none}
button{font:inherit;color:inherit;cursor:pointer}
button:focus-visible,input:focus-visible{outline:2px solid var(--accent);outline-offset:1px}
#app{height:100%;display:grid;grid-template-rows:auto minmax(0,1fr) auto}
.gut{padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
header{padding-block:8px;display:flex;flex-wrap:wrap;align-items:center;gap:6px 18px;background:var(--panel);border-bottom:1px solid var(--line)}
h1{margin:0;font:700 20px/1 var(--font-head);letter-spacing:.06em;text-transform:uppercase;color:var(--accent)}
.clock{font:600 18px/1 var(--font-head);letter-spacing:.04em;font-variant-numeric:tabular-nums;min-width:8.5em}
.clock small{display:block;font:500 11px/1.2 var(--font-body);color:var(--mute);letter-spacing:.02em}
.speed{display:flex;gap:2px}
.speed button{background:var(--panel2);border:1px solid var(--line);padding:5px 10px;font:600 13px/1 var(--font-head);letter-spacing:.04em}
.speed button:first-child{border-radius:6px 0 0 6px}.speed button:last-child{border-radius:0 6px 6px 0}
.speed button.on{background:var(--accent);color:#1b1407;border-color:var(--accent)}
.res{display:flex;gap:14px;font:600 16px/1 var(--font-head);font-variant-numeric:tabular-nums}
.res span{display:flex;align-items:center;gap:6px}
.res .ic{width:22px;height:22px;display:block}
.tool .ic{width:20px;height:20px;flex:none}
.net{margin-left:auto;display:flex;align-items:center;gap:8px;font-size:12px;color:var(--mute)}
.net b{width:8px;height:8px;border-radius:50%;background:var(--mute);display:inline-block}
.net.ok b{background:var(--good)}.net.warn b{background:var(--accent)}
#panelBtn{background:var(--panel2);border:1px solid var(--line);border-radius:6px;padding:5px 10px;font:600 13px/1 var(--font-head);letter-spacing:.04em}
#stage{display:flex;min-height:0;position:relative}
#view{flex:1;position:relative;min-width:0;background:#26331f;overflow:hidden}
#cv{position:absolute;inset:0;width:100%;height:100%;touch-action:none;display:block;cursor:crosshair}
#hint{position:absolute;left:max(12px,env(safe-area-inset-left,0px));top:10px;max-width:70%;font-size:12px;color:#dfe5dc;background:rgba(18,23,26,.72);padding:5px 9px;border-radius:6px;pointer-events:none}
#zoom{position:absolute;right:10px;bottom:10px;display:flex;flex-direction:column;gap:4px}
#zoom button{width:34px;height:34px;border-radius:8px;background:rgba(27,34,38,.85);border:1px solid var(--line);font:600 18px/1 var(--font-head)}
#alert{position:absolute;left:50%;top:14px;transform:translateX(-50%);background:var(--bad);color:#fff;font:600 16px/1 var(--font-head);letter-spacing:.05em;padding:9px 16px;border-radius:8px;display:none;text-align:center;max-width:90%}
#toast{position:absolute;left:50%;bottom:14px;transform:translateX(-50%);background:var(--panel2);border:1px solid var(--line);padding:8px 14px;border-radius:8px;display:none;max-width:90%;text-align:center}
#over{position:absolute;inset:0;background:rgba(10,12,14,.78);display:none;align-items:center;justify-content:center;flex-direction:column;gap:14px;text-align:center;padding:24px}
#over h2{margin:0;font:700 34px/1 var(--font-head);letter-spacing:.06em;text-transform:uppercase}
#over p{margin:0;color:var(--mute);max-width:32em}
.btn{background:var(--accent);color:#1b1407;border:0;border-radius:8px;padding:10px 18px;font:700 15px/1 var(--font-head);letter-spacing:.05em;text-transform:uppercase}
.btn.ghost{background:var(--panel2);color:var(--fg);border:1px solid var(--line)}
#side{width:300px;flex:none;background:var(--panel);border-left:1px solid var(--line);overflow-y:auto;display:flex;flex-direction:column;min-height:0}
#side.closed{display:none}
#side section{padding:10px 14px 12px;border-bottom:1px solid var(--line)}
#side h3{margin:0 0 8px;font:600 12px/1 var(--font-head);letter-spacing:.14em;text-transform:uppercase;color:var(--mute)}
.pl{display:flex;align-items:center;gap:8px;padding:2px 0}
.pl i{width:9px;height:9px;border-radius:50%;flex:none}
.pl span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.pl em{font-style:normal;color:var(--mute);font-size:11px;margin-left:auto;flex:none}
.col{display:block;width:100%;text-align:left;background:var(--panel2);border:1px solid var(--line);border-radius:8px;padding:7px 9px;margin-bottom:6px}
.col.sel{border-color:var(--accent)}
.col .top{display:flex;align-items:center;gap:8px;font-weight:600}
.col .top i{width:10px;height:10px;border-radius:50%}
.col .top em{margin-left:auto;font-style:normal;font-weight:400;font-size:12px;color:var(--mute)}
.bars{display:grid;grid-template-columns:repeat(4,1fr);gap:4px;margin-top:6px}
.bar{height:5px;background:#10151a;border-radius:3px;overflow:hidden}
.bar b{display:block;height:100%;border-radius:3px}
#log{max-height:170px;overflow-y:auto;font-size:12.5px;line-height:1.35;color:#cdd5cf}
#log div{padding:2px 0;border-bottom:1px dashed #2b363c}
#log div.a{color:#ff9a88}
#log small{color:var(--mute);margin-right:6px;font-variant-numeric:tabular-nums}
#chatlog{max-height:120px;overflow-y:auto;font-size:12.5px;margin-bottom:6px}
#chatlog b{color:var(--accent);font-weight:600}
#chatin{width:100%;background:#10151a;border:1px solid var(--line);border-radius:6px;color:var(--fg);padding:7px 9px;font:inherit;user-select:text;-webkit-user-select:text}
#tools{display:flex;gap:6px;align-items:stretch;overflow-x:auto;padding-block:8px;background:var(--panel);border-top:1px solid var(--line);padding-bottom:max(8px,env(safe-area-inset-bottom,0px))}
.grp{display:flex;gap:6px;align-items:stretch;flex:none}
.grp+.grp{border-left:1px solid var(--line);padding-left:8px;margin-left:2px}
.tool{display:flex;flex-direction:column;align-items:flex-start;justify-content:center;gap:2px;min-width:74px;background:var(--panel2);border:1px solid var(--line);border-radius:8px;padding:6px 9px;text-align:left;flex:none}
.tool b{display:flex;align-items:center;gap:6px;font:600 14px/1 var(--font-head);letter-spacing:.03em;white-space:nowrap}
.tool b i{width:11px;height:11px;border-radius:3px;display:inline-block;border:1px solid rgba(255,255,255,.25)}
.tool small{font-size:10.5px;color:var(--mute);white-space:nowrap}
.tool.on{border-color:var(--accent);background:#3a3321}
#helpBtn{background:var(--panel2);border:1px solid var(--line);border-radius:6px;padding:5px 10px;font:600 13px/1 var(--font-head);letter-spacing:.04em}
.threat{font:600 14px/1 var(--font-head);letter-spacing:.04em;background:var(--bad);color:#fff;padding:6px 10px;border-radius:6px}
#hintTool{font-weight:600}
#hintGoal{color:var(--accent);margin-top:2px}
#help{position:absolute;inset:0;z-index:20;background:rgba(10,12,14,.84);display:none;overflow:auto;padding:14px}
#help .card{max-width:660px;margin:0 auto;background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:18px 20px;user-select:text;-webkit-user-select:text}
#help h2{margin:0 0 10px;font:700 26px/1 var(--font-head);letter-spacing:.05em;text-transform:uppercase;color:var(--accent)}
#help h4{margin:14px 0 4px;font:600 13px/1 var(--font-head);letter-spacing:.12em;text-transform:uppercase;color:var(--mute)}
#help p,#help li{margin:0 0 4px;font-size:14px;line-height:1.45}
#help ul{margin:0;padding-left:18px}
#help kbd{background:#10151a;border:1px solid var(--line);border-radius:4px;padding:0 5px;font:600 12px var(--font-body)}
#sel{position:absolute;left:max(12px,env(safe-area-inset-left,0px));bottom:10px;background:rgba(27,34,38,.92);border:1px solid var(--line);border-radius:10px;padding:8px 12px;min-width:190px;display:none;pointer-events:none}
#sel b{font:600 15px/1.2 var(--font-head);letter-spacing:.03em}
#sel small{display:block;color:var(--mute);font-size:12px;margin-bottom:4px}
.goal{display:flex;gap:8px;align-items:flex-start;padding:3px 0;color:var(--mute);font-size:13px}
.goal i{width:14px;height:14px;border-radius:4px;border:1.5px solid var(--line);flex:none;margin-top:2px;position:relative}
.goal.done{color:var(--good)}
.goal.done i{background:var(--good);border-color:var(--good)}
.goal.done i::after{content:"";position:absolute;left:3px;top:0;width:4px;height:8px;border:solid #10151a;border-width:0 2px 2px 0;transform:rotate(40deg)}
.goal.now{color:var(--fg);font-weight:600}
.goal.now i{border-color:var(--accent)}
.goal small{display:block;font-weight:400;color:var(--mute);font-size:12px}
.rec{display:flex;align-items:center;gap:8px;padding:6px 0;border-bottom:1px dashed #2b363c}
.rec div:first-child{flex:1;min-width:0}
.rec b{font:600 14px/1.2 var(--font-head);letter-spacing:.03em}
.rec small{display:block;color:var(--mute);font-size:11.5px}
.rec .q{display:flex;align-items:center;gap:6px;font-variant-numeric:tabular-nums}
.rec .q button{width:26px;height:26px;border-radius:6px;background:var(--panel2);border:1px solid var(--line);font:600 15px/1 var(--font-head)}
.rec .q span{min-width:1.2em;text-align:center;font-weight:600}
.note{font-size:12.5px;color:var(--mute);margin:0 0 6px}
#armory{font-size:12.5px;color:#cdd5cf;margin-top:6px}
.col .top small{color:var(--mute);font-weight:400;font-size:11px}
@media (max-width:760px){
  #side{position:absolute;right:0;top:0;bottom:0;z-index:5;width:min(320px,88vw);box-shadow:-8px 0 24px rgba(0,0,0,.45)}
  .res{gap:10px;font-size:15px}
  .net{margin-left:0}
}
@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
</style>

<div id="app">
  <header class="gut">
    <h1>Рубеж</h1>
    <div class="clock" id="clock">День 1<small>06:00</small></div>
    <div class="speed" id="speed">
      <button data-s="0" title="Пауза (Пробел)">Пауза</button>
      <button data-s="1" title="Клавиша 1">×1</button>
      <button data-s="2" title="Клавиша 2">×2</button>
      <button data-s="3" title="Клавиша 3">×3</button>
    </div>
    <div class="res">
      <span title="Дерево"><canvas class="ic" data-n="wood" width="44" height="44"></canvas><b id="rWood">0</b></span>
      <span title="Камень"><canvas class="ic" data-n="stone" width="44" height="44"></canvas><b id="rStone">0</b></span>
      <span title="Еда"><canvas class="ic" data-n="meat" width="44" height="44"></canvas><b id="rFood">0</b></span>
    </div>
    <div class="net" id="net"><b></b><span id="netTxt">Подключение…</span></div>
    <div class="threat" id="threat" hidden></div>
    <button id="helpBtn">Как играть</button>
    <button id="panelBtn" aria-expanded="true">Панель</button>
  </header>

  <div id="stage">
    <div id="view">
      <canvas id="cv"></canvas>
      <div id="hint"><div id="hintTool"></div><div id="hintGoal"></div></div>
      <div id="sel"></div>
      <div id="zoom"><button id="zin" aria-label="Приблизить">+</button><button id="zout" aria-label="Отдалить">−</button></div>
      <div id="alert"></div>
      <div id="help" role="dialog" aria-modal="true" aria-labelledby="helpTitle"><div class="card">
        <h2 id="helpTitle">Как играть</h2>
        <p>Вы вместе с друзьями управляете одной колонией. Колонисты сами едят, спят и работают. Вы говорите им, что делать, и защищаете лагерь.</p>
        <h4>Управление</h4>
        <ul>
          <li><b>Приказ:</b> выберите инструмент внизу, затем проведите рамку по карте мышью или пальцем.</li>
          <li><b>Камера:</b> инструмент «Двигать» и перетаскивание, либо <kbd>W</kbd><kbd>A</kbd><kbd>S</kbd><kbd>D</kbd> и стрелки. Масштаб: колесо мыши, кнопки +/− или щипок двумя пальцами. Правая кнопка мыши всегда двигает карту.</li>
          <li><kbd>Пробел</kbd> пауза, <kbd>1</kbd> <kbd>2</kbd> <kbd>3</kbd> скорость, <kbd>Esc</kbd> вернуться к «Двигать» или закрыть окно.</li>
          <li>Нажмите на колониста, чтобы увидеть его состояние. Список колонистов, журнал и чат в панели справа (кнопка «Панель»).</li>
        </ul>
        <h4>С чего начать</h4>
        <ul>
          <li>«Рубка» по деревьям и «Шахта» по тёмно-серым скалам: дерево и камень нужны для всего.</li>
          <li>«Кровать» и «Грядка»: колонистам нужны сон и еда. «Ягоды» и «Охота» дают еду сразу.</li>
          <li>Подсказка «Цель» вверху карты и список целей справа ведут по порядку.</li>
        </ul>
        <h4>Верстак и оружие</h4>
        <ul>
          <li>Постройте «Верстак». В панели «Верстак и оружие» нажмите «+» у пистолета или винтовки: колонист сам придёт к верстаку и сделает.</li>
          <li>Оружие достаётся безоружным колонистам автоматически, винтовка лучше пистолета. Без оружия колонист бьёт только вплотную.</li>
        </ul>
        <h4>Враги</h4>
        <ul>
          <li><b>Налётчики</b> стреляют, <b>громилы</b> бьют вплотную. Оба ломают стены и двери. С налётчиков иногда падает пистолет.</li>
          <li><b>Волки, медведи и пауки</b> не ломают постройки и не проходят через закрытые стены и двери. С волков и медведей остаётся мясо.</li>
          <li>«Башня» стреляет сама. Стройте её у входа в лагерь.</li>
        </ul>
        <h4>Онлайн</h4>
        <p>Играть могут до 5 человек, остальные только смотрят. Каждый видит курсоры других и может писать в чат. Приказывать могут участники с правом Contributor.</p>
        <p style="margin-top:14px"><button class="btn" id="helpClose">Понятно, играть</button></p>
      </div></div>
      <div id="toast"></div>
      <div id="over">
        <h2>Колония погибла</h2>
        <p>Все колонисты мертвы. Мир общий для всех игроков: новую колонию начнёт каждый, кто откроет страницу после сброса.</p>
        <button class="btn" id="resetBtn">Начать заново</button>
      </div>
    </div>
    <aside id="side">
      <section><h3>Цели</h3><div id="goals"></div></section>
      <section><h3>Игроки онлайн</h3><div id="players"></div></section>
      <section><h3>Колонисты</h3><div id="cols"></div></section>
      <section id="craft"><h3>Верстак и оружие</h3>
        <p class="note" id="benchnote"></p>
        <div class="rec"><div><b>Пистолет</b><small>6 дер. 10 кам. · урон 12 · дальность 6</small></div><div class="q"><button data-k="pistol" data-d="-1" aria-label="Убрать из очереди">−</button><span id="q_pistol">0</span><button data-k="pistol" data-d="1" aria-label="Добавить в очередь">+</button></div></div>
        <div class="rec"><div><b>Винтовка</b><small>12 дер. 20 кам. · урон 22 · дальность 9</small></div><div class="q"><button data-k="rifle" data-d="-1" aria-label="Убрать из очереди">−</button><span id="q_rifle">0</span><button data-k="rifle" data-d="1" aria-label="Добавить в очередь">+</button></div></div>
        <div id="armory"></div></section>
      <section><h3>Журнал</h3><div id="log"></div></section>
      <section><h3>Чат</h3><div id="chatlog"></div><input id="chatin" maxlength="140" placeholder="Сообщение и Enter" autocomplete="off"></section>
      <section id="newgame" style="display:none"><button class="btn ghost" id="resetBtn2">Новый мир</button></section>
    </aside>
  </div>

  <nav id="tools" class="gut" aria-label="Приказы и постройки"></nav>
</div>

