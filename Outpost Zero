/* ---------- сериализация ---------- */
function ser(){return JSON.stringify(Object.assign({},world,{T:world.T.join(''),S:world.S.join('')}),(k,v)=>k==='bad'?undefined:v);}
function deser(s){const w=JSON.parse(s); w.T=w.T.split(''); w.S=w.S.split(''); if(w.T.length!==N||w.S.length!==N)throw new Error('bad'); for(const c of w.cols)c.bad={}; return w;}

/* ---------- поиск пути ---------- */
const prev=new Int32Array(N), queue=new Int32Array(N);
function bfs(start,goal,passable){
  prev.fill(-2); prev[start]=-1; let h=0,t=0; queue[t++]=start;
  while(h<t){
    const c=queue[h++];
    if(goal(c)){const p=[];let q=c;while(q!==start){p.push(q);q=prev[q];}p.reverse();return p;}
    const x=c%W,y=(c/W)|0;
    for(let d=0;d<4;d++){
      const nx=x+(d===0?1:d===1?-1:0),ny=y+(d===2?1:d===3?-1:0);
      if(nx<0||ny<0||nx>=W||ny>=H)continue;
      const n=ny*W+nx; if(prev[n]!==-2||!passable(n))continue;
      prev[n]=c; queue[t++]=n;
    }
  }
  return null;
}
function walk(i){const t=world.T[i]; if(t==='#'||t==='~'||t==='t')return false; const s=world.S[i]; return s!=='w'&&s!=='o'&&s!=='k';}
function rawWalk(i){const t=world.T[i]; return t!=='#'&&t!=='~'&&t!=='t';}
function pathNear(c,ti,reach,notSelf){
  const tx=X(ti),ty=Y(ti);
  return bfs(I(c.x,c.y),n=>{const x=n%W,y=(n/W)|0; if(Math.max(Math.abs(x-tx),Math.abs(y-ty))>reach)return false; if(notSelf&&n===ti)return false; return walk(n)||n===I(c.x,c.y);},walk);
}
function entityAt(x,y){for(const c of world.cols)if(c.x===x&&c.y===y)return true; for(const r of world.raid)if(r.x===x&&r.y===y)return true; return false;}

/* ---------- приказы ---------- */
function validRect(c){
  const x0=clamp(c.x0|0,0,W-1),x1=clamp(c.x1|0,0,W-1),y0=clamp(c.y0|0,0,H-1),y1=clamp(c.y1|0,0,H-1);
  const a={x0:Math.min(x0,x1),x1:Math.max(x0,x1),y0:Math.min(y0,y1),y1:Math.max(y0,y1)};
  if((a.x1-a.x0+1)*(a.y1-a.y0+1)>600)return null; return a;
}
function sanitize(d){
  if(!d||typeof d!=='object'||typeof d.id!=='string'||d.id.length>24)return null;
  const o={id:d.id,t:d.t};
  if(d.t==='speed'){o.v=clamp(d.v|0,0,3);return o;}
  if(d.t==='reset'){o.seed=d.seed|0;return o;}
  if(d.t==='craft'){if(typeof d.k!=='string'||!Object.hasOwn(RECIPE,d.k))return null;o.k=d.k;o.n=d.n>0?1:-1;return o;}
  if(d.t==='des'||d.t==='build'){
    if(typeof d.k!=='string')return null;
    const ok=d.t==='des'?['mine','chop','harvest','hunt','cancel','demo']:Object.keys(KIND);
    if(!ok.includes(d.k))return null;
    o.k=d.k; o.x0=d.x0|0;o.x1=d.x1|0;o.y0=d.y0|0;o.y1=d.y1|0; return o;
  }
  return null;
}
function applyOnce(cmd,fromReplay){
  if(!world||world.ca.includes(cmd.id))return;
  world.ca.push(cmd.id); if(world.ca.length>40)world.ca.shift();
  if(!fromReplay){recent.push({cmd,at:Date.now()}); while(recent.length&&Date.now()-recent[0].at>12000)recent.shift();}
  if(cmd.t==='speed'){world.speed=cmd.v;}
  else if(cmd.t==='craft'){world.Q[cmd.k]=clamp((world.Q[cmd.k]|0)+cmd.n,0,5);}
  else if(cmd.t==='reset'){genWorld(cmd.seed); world.ca=[cmd.id]; recent.length=0; selected=null;}
  else{
    const r=validRect(cmd); if(!r)return;
    for(let y=r.y0;y<=r.y1;y++)for(let x=r.x0;x<=r.x1;x++){
      const i=I(x,y),t=world.T[i];
      if(cmd.t==='des'){
        if(cmd.k==='hunt'){for(const a of world.an)if(a.x===x&&a.y===y)a.h=1;}
        else if(cmd.k==='cancel'){for(const a of world.an)if(a.x===x&&a.y===y)a.h=0;delete world.D[i];delete world.B[i];for(const c of world.cols)if(c.job&&c.job.idx===i&&c.job.k!=='eat'&&c.job.k!=='sleep')c.job=null;}
        else if(cmd.k==='demo'){delete world.B[i]; if(world.S[i]!==' '){world.S[i]=' ';delete world.G[i];delete world.HP[i];}}
        else if(!world.D[i]){
          if((cmd.k==='mine'&&t==='#')||(cmd.k==='chop'&&t==='t')||(cmd.k==='harvest'&&t==='b'))world.D[i]=cmd.k;
        }
      }else{
        if((t==='.'||t===',')&&world.S[i]===' '&&!world.B[i]&&!world.D[i])world.B[i]=cmd.k;
      }
    }
  }
  if(mode==='online'&&isLeader){dirty=true;dirtyAt=Date.now();}
}
const EMPTYMSG={mine:'В рамке нет скал. Скалы тёмно-серые.',chop:'В рамке нет деревьев.',harvest:'В рамке нет кустов с ягодами.',hunt:'В рамке нет животных.',cancel:'В рамке нечего отменять.',demo:'В рамке нечего сносить.',build:'Здесь нельзя строить: нужна свободная трава или земля.'};
function previewRect(t,r){
  const w=world; let n=0;
  if(t==='hunt'){return w.an.filter(a=>a.x>=r.x0&&a.x<=r.x1&&a.y>=r.y0&&a.y<=r.y1&&!a.h).length;}
  for(let y=r.y0;y<=r.y1;y++)for(let x=r.x0;x<=r.x1;x++){
    const i=I(x,y),tt=w.T[i];
    if(t==='mine'){if(tt==='#'&&!w.D[i])n++;}
    else if(t==='chop'){if(tt==='t'&&!w.D[i])n++;}
    else if(t==='harvest'){if(tt==='b'&&!w.D[i])n++;}
