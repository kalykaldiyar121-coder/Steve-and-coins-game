    }
    if(s==='d'||s==='e'||s==='c'||s==='o'||s==='k')drawBuilding(s,sx,sy,z,i,now,false);
  }
  // приказы и чертежи
  ctx.lineWidth=2;
  for(const key in W_.D){const i=+key,x=i%W,y=(i/W)|0; if(x<x0||x>x1||y<y0||y>y1)continue; const k=W_.D[i];
    ctx.strokeStyle=k==='mine'?'#f0b255':k==='chop'?'#8fd687':'#ff8fa6'; ctx.setLineDash([5,4]); ctx.strokeRect(ox+x*z+2,oy+y*z+2,z-4,z-4); ctx.setLineDash([]);
    ctx.fillStyle=k==='mine'?'rgba(240,178,85,.22)':k==='chop'?'rgba(143,214,135,.22)':'rgba(255,143,166,.25)'; ctx.fillRect(ox+x*z+2,oy+y*z+2,z-4,z-4);}
