    if(E.s){top=sy+z*.45-z*E.h;if(!spFit(E.s,sx,sy+z*.45,z*E.h,r.fl===1)){ctx.fillStyle='#7a3a2a';ctx.beginPath();ctx.arc(sx,sy,z*.3,0,7);ctx.fill();}}
