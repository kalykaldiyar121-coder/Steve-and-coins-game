/* ---------- симуляция ---------- */
function isNight(){const h=(world.tick%TPD)/100; return h<6||h>=20;}
function nearFire(c,r){for(let dy=-r;dy<=r;dy++)for(let dx=-r;dx<=r;dx++){const x=c.x+dx,y=c.y+dy; if(inb(x,y)&&world.S[I(x,y)]==='c')return true;}return false;}
function findFire(c){let best=-1,bd=1e9;for(let i=0;i<N;i++)if(world.S[i]==='c'){const d=Math.abs(X(i)-c.x)+Math.abs(Y(i)-c.y);if(d<bd){bd=d;best=i;}}return best;}
function claimed(i,k,self){for(const o of world.cols)if(o!==self&&o.job&&o.job.idx===i&&o.job.k===k)return true;return false;}
function affordRec(k){const r=RECIPE[k];return world.res.wood>=r.wood&&world.res.stone>=r.stone;}
function canAfford(kind){const co=COST[kind];for(const k in co)if(world.res[k]<co[k])return false;return true;}

function pickWork(c){
  const cand=[];
  const add=(k,i,bias)=>{if(c.bad[i]>world.tick)return; if(claimed(i,k,c))return; cand.push({k,i,d:Math.abs(X(i)-c.x)+Math.abs(Y(i)-c.y)+bias});};
  for(const key in world.G){const i=+key; if(world.S[i]==='p'&&world.G[i]>=100)add('reap',i,-12);}
  for(const key in world.B){const i=+key; if(canAfford(world.B[i]))add('build',i,-6);}
  for(const key in world.D){const i=+key; add(world.D[i],i,0);}
  if(world.Q.pistol>0||world.Q.rifle>0){
    const ok=['rifle','pistol'].some(k=>world.Q[k]>0&&affordRec(k));
    if(ok)for(let i=0;i<N;i++)if(world.S[i]==='k')add('craft',i,-4);
  }
  for(const a of world.an){ if(!a.h||c.bad['a'+a.id]>world.tick)continue; if(world.cols.some(o=>o!==c&&o.job&&o.job.k==='hunt'&&o.job.aid===a.id))continue; cand.push({k:'hunt',i:-1,aid:a.id,d:Math.abs(a.x-c.x)+Math.abs(a.y-c.y)+2}); }
  if(!cand.length)return false;
  cand.sort((a,b)=>a.d-b.d);
  for(let n=0;n<Math.min(5,cand.length);n++){
    const t=cand[n];
    if(t.k==='hunt'){const a=world.an.find(q=>q.id===t.aid); const p=pathNear(c,I(a.x,a.y),1,false); if(p){c.job={k:'hunt',idx:-1,aid:t.aid,p,w:0};return true;} c.bad['a'+t.aid]=world.tick+300; continue;}
    const bk=t.k==='build'?world.B[t.i]:null;
    const p=pathNear(c,t.i,1,isBlock(bk));
    if(p){c.job={k:t.k,idx:t.i,p,w:0,paid:false};return true;}
    c.bad[t.i]=world.tick+400;
  }
  return false;
}
function stepMove(c,j){
  if(c.mt>0){c.mt--;return true;}
  if(!j.p.length)return false;
  const nx=j.p[0];
  if(!walk(nx)){
    const re=j.idx>=0?pathNear(c,j.idx,j.k==='eat'?2:1,j.k==='build'&&isBlock(world.B[j.idx])):null;
    if(re)j.p=re;else{c.job=null;}
    return true;
  }
  c.fl=X(nx)<c.x?1:X(nx)>c.x?0:c.fl;c.x=X(nx);c.y=Y(nx);j.p.shift();c.mt=3;return true;
}
function finishWork(c,j){
  const i=j.idx,w=world;
  if(j.k==='mine'){w.T[i]=',';delete w.D[i];w.res.stone+=4;}
  else if(j.k==='chop'){w.T[i]='.';delete w.D[i];w.res.wood+=6;}
  else if(j.k==='harvest'){w.T[i]='B';delete w.D[i];w.res.food+=6;}
  else if(j.k==='reap'){w.G[i]=0;w.res.food+=10;}
  else if(j.k==='build'){
    const kind=w.B[i]; delete w.B[i]; w.S[i]=KIND[kind];
    if(kind==='farm')w.G[i]=0;
    if(kind==='wall')w.HP[i]=80; if(kind==='door')w.HP[i]=50; if(kind==='tower')w.HP[i]=100;
  }
  c.job=null;
}
function validTarget(j){
  const w=world,i=j.idx;
  if(j.k==='mine')return w.T[i]==='#'&&w.D[i]==='mine';
  if(j.k==='chop')return w.T[i]==='t'&&w.D[i]==='chop';
  if(j.k==='harvest')return w.T[i]==='b'&&w.D[i]==='harvest';
  if(j.k==='reap')return w.S[i]==='p'&&w.G[i]>=100;
  if(j.k==='build')return !!w.B[i];
  if(j.k==='craft')return w.S[i]==='k';
  return true;
}
function tickColonist(c){
  const w=world;
  c.hn=Math.max(0,c.hn-0.02);
  if(!c.sl)c.rs=Math.max(0,c.rs-0.03);
  if(c.fed>0)c.fed--; if(c.gr>0)c.gr--; if(c.mb>0)c.mb=Math.max(0,c.mb-0.004); else if(c.mb<0)c.mb=Math.min(0,c.mb+0.004);
  let tg=55+(c.hn>50?8:c.hn<20?-30:0)+(c.rs>50?6:c.rs<20?-28:0)+(nearFire(c,4)?6:0)+c.mb+(c.fed>0?8:0)+(c.gr>0?-20:0);
  c.md+=(clamp(tg,0,100)-c.md)*0.04;
  if(c.hn<=0)c.hp-=0.04; else if(c.hp<100)c.hp=Math.min(100,c.hp+(c.sl?0.05:0.015));
  if(c.hp<=0)return false;
  if(!c.sl){
    const bw=w.stock.rifle>0?'rifle':w.stock.pistol>0?'pistol':null;
    if(bw&&WP[bw].dmg>WP[c.wp].dmg){if(c.wp!=='fist')w.stock[c.wp]++;w.stock[bw]--;c.wp=bw;logAdd(c.n+' берёт оружие: '+WP[bw].n.toLowerCase()+'.',false);}
  }
  // враги
  let en=null,ed=99;
  for(const r of w.raid){const d=cheb(c,r); if(d<ed){ed=d;en=r;}}
  if(c.cd>0)c.cd--;
  if(en&&ed<=9&&c.sl){c.sl=false;c.job=null;}
  const wpn=WP[c.wp]||WP.fist;
  if(en&&ed<=wpn.rng&&!c.sl){
    c.fl=en.x<c.x?1:0;
    if(c.cd===0){en.hp-=wpn.dmg;c.cd=wpn.cd;fx.push({x0:c.x,y0:c.y,x1:en.x,y1:en.y,t:performance.now()+(wpn.rng>1?140:90),c:wpn.rng>1?'#ffe7a0':'#ffffff'});}
    return true;
  }
  if(c.brk>0){
    c.brk--; c.job=null;
    if(c.mt>0)c.mt--; else{const d=ri(0,3),nx=c.x+(d===0?1:d===1?-1:0),ny=c.y+(d===2?1:d===3?-1:0); if(inb(nx,ny)&&walk(I(nx,ny))){c.x=nx;c.y=ny;c.mt=3;}}
    return true;
  }
  if(c.md<12&&rnd()<0.002){c.brk=80;logAdd(c.n+': нервный срыв, бродит без дела.',false);return true;}
  if(c.sl){
    c.rs=Math.min(100,c.rs+0.12);
    if(c.rs>=96||c.hn<8){c.sl=false;c.job=null;}
    return true;
  }
  const work=c.job&&['mine','chop','harvest','reap','build','hunt','craft'].includes(c.job.k);
  if(work&&((c.hn<18&&w.res.food>=1)||c.rs<8))c.job=null;
  if(!c.job){
    if(c.hn<35&&w.res.food>=1){
      const f=findFire(c);
      if(f>=0){const p=pathNear(c,f,2,false); if(p)c.job={k:'eat',idx:f,p,w:0};}
      if(!c.job)c.job={k:'eat',idx:-1,p:[],w:0};
    }else if(c.rs<22||(isNight()&&c.rs<65)){
      let best=-1,bd=1e9;
      for(let i=0;i<N;i++)if(w.S[i]==='e'&&!w.cols.some(o=>o!==c&&o.job&&o.job.k==='sleep'&&o.job.idx===i)){const d=Math.abs(X(i)-c.x)+Math.abs(Y(i)-c.y);if(d<bd){bd=d;best=i;}}
      if(best>=0&&bd<60){const p=pathNear(c,best,0,false); if(p)c.job={k:'sleep',idx:best,p,w:0};}
      if(!c.job)c.job={k:'sleep',idx:-1,p:[],w:0};
    }else if(!pickWork(c)){
      if(rnd()<0.012){
        const nx=c.x+ri(-3,3),ny=c.y+ri(-3,3);
        if(inb(nx,ny)&&walk(I(nx,ny))){const p=bfs(I(c.x,c.y),n=>n===I(nx,ny),walk); if(p&&p.length)c.job={k:'idle',idx:-1,p,w:0};}
      }
    }
  }
  const j=c.job; if(!j)return true;
  if(j.k==='hunt'){
    const a=w.an.find(q=>q.id===j.aid);
    if(!a||!a.h){c.job=null;return true;}
    if(c.mt>0){c.mt--;return true;}
    if(cheb(c,a)<=1){j.w++; if(j.w>=DUR.hunt){w.an.splice(w.an.indexOf(a),1);w.res.food+=ANI[a.k].f;c.job=null;} return true;}
    if(!j.p.length||w.tick%8===0){const p=pathNear(c,I(a.x,a.y),1,false); if(!p){c.bad['a'+a.id]=w.tick+300;c.job=null;return true;} j.p=p;}
    if(j.p.length){const nx=j.p.shift(); if(walk(nx)){c.x=X(nx);c.y=Y(nx);c.mt=3;}}
    return true;
  }
  if(j.p.length||c.mt>0){stepMove(c,j);return true;}
  // на месте
  if(j.k==='sleep'){c.sl=true;c.mb=j.idx>=0?8:-10;c.job=null;return true;}
  if(j.k==='idle'){c.job=null;return true;}
  if(j.k==='eat'){
    j.w++;
    if(j.w>=DUR.eat){
      const u=Math.min(3,Math.floor(w.res.food)); if(u>0){w.res.food-=u;c.hn=Math.min(100,c.hn+u*17);if(j.idx>=0&&nearFire(c,3))c.fed=1200;}
      c.job=null;
    }
    return true;
  }
  if(!validTarget(j)){c.job=null;return true;}
  if(j.k==='craft'){
    if(!j.rk){
      const k=['rifle','pistol'].find(k=>w.Q[k]>0&&affordRec(k));
      if(!k){c.bad[j.idx]=w.tick+200;c.job=null;return true;}
      w.res.wood-=RECIPE[k].wood;w.res.stone-=RECIPE[k].stone;j.rk=k;j.w=0;
    }
    j.w++;
    if(j.w>=RECIPE[j.rk].t){w.Q[j.rk]=Math.max(0,w.Q[j.rk]-1);w.stock[j.rk]++;logAdd('Изготовлено: '+WP[j.rk].n.toLowerCase()+'.',false);c.job=null;}
    return true;
  }
  if(j.k==='build'){
    const kind=w.B[j.idx];
    if(!j.paid){
      if(!canAfford(kind)){c.bad[j.idx]=w.tick+300;c.job=null;return true;}
      for(const k in COST[kind])w.res[k]-=COST[kind][k]; j.paid=true;
    }
    j.w++;
    if(j.w>=DUR[kind]){
      if(isBlock(kind)&&entityAt(X(j.idx),Y(j.idx))){j.w=DUR[kind]-1;return true;}
      finishWork(c,j);
    }
    return true;
  }
  j.w++;
  if(j.w>=DUR[j.k])finishWork(c,j);
  return true;
}
function spawnEdge(){
  for(let a=0;a<60;a++){
    const side=ri(0,3);let x,y;
    if(side===0){x=0;y=ri(1,H-2);}else if(side===1){x=W-1;y=ri(1,H-2);}else if(side===2){y=0;x=ri(1,W-2);}else{y=H-1;x=ri(1,W-2);}
    if(rawWalk(I(x,y))&&!entityAt(x,y))return{x,y,side};
  }
  return null;
}
function spawnEnemy(t,x,y){const E=ENM[t];world.raid.push({id:world.nid++,t,x,y,hp:E.hp,cd:20,mt:0,p:[],pt:0,fl:0});}
function tickRaider(r){
  const w=world,E=ENM[r.t]||ENM.raider;
  if(r.cd>0)r.cd--;
  let best=null,bd=99;
  for(const c of w.cols){const d=cheb(r,c);if(d<bd){bd=d;best=c;}}
  if(!best)return;
  if(bd<=E.rng){
    r.fl=best.x<r.x?1:0;
    if(r.cd===0){best.hp-=E.dmg;r.cd=E.cd;fx.push({x0:r.x,y0:r.y,x1:best.x,y1:best.y,t:performance.now()+(E.rng>1?140:90),c:E.rng>1?'#ff8a70':'#ffd0c0'});}
    return;
  }
  if(r.mt>0){r.mt--;return;}
  if(!r.p||!r.p.length||r.pt<=0){
    const tx=best.x,ty=best.y,reach=E.rng>1?3:1;
    const pass=E.bandit?rawWalk:(n=>walk(n)&&w.S[n]!=='d');
    r.p=bfs(I(r.x,r.y),n=>Math.max(Math.abs(X(n)-tx),Math.abs(Y(n)-ty))<=reach,pass)||[];
    r.pt=25;
  }
  r.pt--;
  if(!r.p.length)return;
  const nx=r.p[0],s=w.S[nx];
  if(E.bandit&&(s==='w'||s==='o'||s==='d'||s==='k')){
    if(r.cd===0){
      w.HP[nx]=(w.HP[nx]??80)-E.wall; r.cd=12;
      fx.push({x0:r.x,y0:r.y,x1:X(nx),y1:Y(nx),t:performance.now()+100,c:'#ffb070'});
      if(w.HP[nx]<=0){w.S[nx]=' ';delete w.HP[nx];logAdd('Налётчики разрушили постройку.',true);}
    }
    return;
  }
  if(!walk(nx)){r.p=[];return;}
  if(X(nx)!==r.x)r.fl=X(nx)<r.x?1:0;
  r.x=X(nx);r.y=Y(nx);r.p.shift();r.mt=E.spd;
}
function simTick(){
  const w=world; if(!w||w.over)return;
  w.tick++;
  const h=(w.tick%TPD)/100, day=h>=6&&h<20;
  for(const k in w.G){ if(w.S[k]!=='p'){delete w.G[k];continue;} if(day&&w.G[k]<100)w.G[k]=Math.min(100,w.G[k]+0.08); }
  if(w.tick%10===0){for(let i=0;i<N;i++)if(w.T[i]==='B'&&rnd()<0.004)w.T[i]='b';}
  for(const c of w.cols.slice()){
    if(!tickColonist(c)){
      w.cols.splice(w.cols.indexOf(c),1);
      logAdd('Колония потеряла: '+c.n+(c.hn<=0?' (голод).':'.'),true);
      for(const o of w.cols)o.gr=600;
      if(selected===c.id)selected=null;
    }
  }
  for(const a of w.an){
    if(a.mt>0){a.mt--;continue;}
    if(rnd()<0.035){const d=ri(0,3),dx=d===0?1:d===1?-1:0,dy=d===2?1:d===3?-1:0,nx=a.x+dx,ny=a.y+dy;
      if(inb(nx,ny)&&rawWalk(I(nx,ny))&&w.S[I(nx,ny)]===' '){a.x=nx;a.y=ny;a.mt=6;if(dx)a.fl=dx<0?1:0;}}
  }
  if(w.tick%600===0&&w.an.length<12){const s=spawnEdge(); if(s)addAnimal(s.x,s.y);}
  for(const r of w.raid)tickRaider(r);
  if(w.raid.length){
    for(let i=0;i<N;i++)if(w.S[i]==='o'){
      const t=w.towerCd?.[i]??0; // не хранится в снимке: стрельба башен зависит от тика
      if((w.tick+i)%12!==0)continue;
      const tx=X(i),ty=Y(i); let tgt=null,td=99;
      for(const r of w.raid){const d=Math.max(Math.abs(r.x-tx),Math.abs(r.y-ty)); if(d<td){td=d;tgt=r;}}
      if(tgt&&td<=8){tgt.hp-=9;fx.push({x0:tx,y0:ty,x1:tgt.x,y1:tgt.y,t:performance.now()+140,c:'#9fd6ff'});}
    }
    for(const r of w.raid){
      if(r.hp>0)continue; const E=ENM[r.t]||ENM.raider;
      if(E.bandit&&rnd()<0.2){w.stock.pistol++;logAdd('С убитого врага упал пистолет.',false);}
      if(E.loot){w.res.food+=E.loot;}
    }
    w.raid=w.raid.filter(r=>r.hp>0);
    if(w.inRaid&&!w.raid.length){w.inRaid=false;logAdd('Угроза миновала.',false);}
  }
  if(w.cols.length&&w.tick>=w.nextRaid){
    const day=Math.floor(w.tick/TPD)+1;
    const n=Math.min(7,1+Math.floor(day/2.5)+(rnd()<0.3?1:0));
    const nb=day>=5?Math.min(3,Math.floor((day-2)/3)):0;
    let side=-1,cnt=0;
    for(let k=0;k<n+nb;k++){const s=spawnEdge(); if(s){side=s.side;cnt++;spawnEnemy(k<n?'raider':'brute',s.x,s.y);}}
    if(cnt){w.inRaid=true;logAdd('Тревога: налётчики ('+cnt+(nb?', среди них громилы':'')+') идут с '+SIDE[side]+'.',true);}
    w.nextRaid=w.tick+Math.floor(TPD*(2.5+rnd()*2));
  }
  if(w.cols.length&&w.tick>=w.nextBeast){
    const day=Math.floor(w.tick/TPD)+1,roll=rnd();
    let t,cnt;
    if(day>=6&&roll<0.3){t='bear';cnt=1+(day>=10?1:0);}
    else if(roll<0.65){t='wolf';cnt=Math.min(6,2+Math.floor(day/3)+ri(0,1));}
    else{t='spider';cnt=Math.min(7,3+Math.floor(day/3)+ri(0,2));}
    const s0=spawnEdge(); let made=0;
    if(s0){
      for(let k=0;k<cnt;k++){
        let x=s0.x,y=s0.y;
        for(let a=0;a<8;a++){const tx=s0.x+ri(-2,2),ty=s0.y+ri(-2,2); if(inb(tx,ty)&&rawWalk(I(tx,ty))&&!entityAt(tx,ty)){x=tx;y=ty;break;}}
        spawnEnemy(t,x,y);made++;
      }
      w.inRaid=true;
      logAdd('Опасность: '+({wolf:'стая волков',bear:'медведь',spider:'пауки'})[t]+' ('+made+') идут с '+SIDE[s0.side]+'.',true);
    }
    w.nextBeast=w.tick+Math.floor(TPD*(1.8+rnd()*2));
  }
  if(w.tick>=w.nextWand){
    if(w.cols.length&&w.cols.length<10){const s=spawnEdge(); if(s){const c=addColonist(s.x,s.y);logAdd(c.n+' присоединяется к колонии.',false);}}
    w.nextWand=w.tick+Math.floor(TPD*(2+rnd()*3));
  }
  if(!w.cols.length&&!w.over){w.over=true;logAdd('Колония погибла.',true);}
}

