    const bw=z*.7;ctx.fillStyle='#000a';ctx.fillRect(sx-bw/2,top-5,bw,4);ctx.fillStyle='#ff7a66';ctx.fillRect(sx-bw/2,top-5,bw*clamp(r.hp/E.hp,0,1),4);
    if(z>=16&&(r.t==='brute'||r.t==='bear')){ctx.fillStyle='#ffb3a6';ctx.strokeStyle='rgba(0,0,0,.7)';ctx.lineWidth=3;ctx.font='600 '+Math.max(10,Math.round(z*.28))+'px Barlow, sans-serif';ctx.textAlign='center';ctx.textBaseline='alphabetic';ctx.strokeText(E.n,sx,top-8);ctx.fillText(E.n,sx,top-8);}
