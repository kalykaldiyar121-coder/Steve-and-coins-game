requestAnimationFrame(draw);

/* ---------- запуск ---------- */
async function withTimeout(p,ms){return Promise.race([p,new Promise(r=>setTimeout(()=>r(null),ms))]);}
async function boot(){
  loadAtlas(); resize();
  {let seen=false;try{seen=!!localStorage.getItem('rubezh_help');}catch(e){} if(!seen)showHelp(true);} setTool('pan');
  if($('side')&&window.innerWidth<760)$('side').classList.add('closed');
  $('panelBtn').setAttribute('aria-expanded',!$('side').classList.contains('closed'));
  const use=window.claude&&window.claude.use?n=>withTimeout(window.claude.use(n).catch(()=>null),8000):()=>Promise.resolve(null);
  [db,room,userCap]=await Promise.all([use('db'),use('room'),use('user')]);
  if(userCap){try{const me=await userCap.me(); if(me.name)myNick=me.name; if(me.color&&/^#[0-9a-f]{6}$/i.test(me.color))myColor=me.color;}catch(e){}}
  if(!db){
    mode='solo'; genWorld(Date.now()&0x7fffffff); centerOn(W/2,H/2); fitView(); return;
  }
  mode='online';
  worldRef=db.doc('world/state'); lockRef=db.doc('world/lock');
  worldRef.onSnapshot(snap=>{
    if(!snap.metadata.fromCache)snapDefinitive=true;
    if(snap.exists){
      snapExists=true; const d=snap.data();
      if(d&&d.by!==myPeer&&(!world||!isLeader)){adopt(snap); if(world&&!boot.centered){boot.centered=true;centerOn(W/2,H/2);fitView();}}
    }else if(!snap.metadata.fromCache)snapExists=false;
    maybeCreate();
    if(world&&!boot.centered){boot.centered=true;centerOn(W/2,H/2);fitView();}
  },e=>{toast('Хранилище недоступно. Играем без синхронизации.');mode='solo';if(!world){genWorld(Date.now()&0x7fffffff);centerOn(W/2,H/2);fitView();}});
  leaseTick(); setInterval(leaseTick,3000);
  if(room){
    room.on('cmd',m=>{const c=sanitize(m.data); if(c)applyOnce(c);},()=>{});
    room.on('chat',m=>{const d=m.data; if(!d||typeof d.m!=='string')return; const p=room.peers().find(q=>q.peer===m.peer); addChat(p?nameOf(p):'Гость',d.m.slice(0,140));},()=>{});
    room.onPeers(async ch=>{
      const ids=[...new Set(ch.peers.map(p=>p.by).filter(Boolean))];
      if(userCap&&ids.length){try{const ps=await userCap.profiles(ids);for(const id of ids)if(ps[id]&&ps[id].name)names[id]=ps[id].name;}catch(e){}}
      updatePlayers();
    },()=>{});
    room.presence({nm:myNick,c:myColor,jt:myJoin}).catch(()=>{});
  }
  setTimeout(()=>{if(!world)toast('Мир ещё не создан. Его создаст участник с правом изменения.');},12000);
}
function fitView(){view.z=clamp(Math.min(cw/30,ch/20),10,28); centerOn(W/2,H/2);}
boot();
