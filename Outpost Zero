<script>
'use strict';
/* ============================================================
   Рубеж: общая колониальная песочница.
   Все клиенты исполняют одну и ту же симуляцию. Один клиент
   (держатель аренды в db) пишет снимок мира, остальные его
   принимают. Приказы летят через room и применяются у всех.
   ============================================================ */
const W=64,H=44,N=W*H,TPD=2400;
const TPS=[0,10,20,40];
const NAMES=['Аня','Борис','Вера','Глеб','Дана','Егор','Жанна','Игорь','Лика','Марк','Нина','Олег','Пётр','Рита','Саша','Тимур','Уля','Фёдор'];
const PCOL=['#e3a645','#6fb1e0','#c78bd9','#7cc47f','#e5806f','#d9d36f','#6fd9c9','#e08fb5'];
