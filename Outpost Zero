    else if(t==='demo'){if(w.S[i]!==' '||w.B[i])n++;}
    else if(KIND[t]){if((tt==='.'||tt===',')&&w.S[i]===' '&&!w.B[i]&&!w.D[i])n++;}
  }
  if(t==='cancel')n+=w.an.filter(a=>a.h&&a.x>=r.x0&&a.x<=r.x1&&a.y>=r.y0&&a.y<=r.y1).length;
  return n;
}
function buildMsg(t,n){
  if(!KIND[t])return 'Приказ отдан: '+n+(t==='hunt'?' животн.':' кл.');
