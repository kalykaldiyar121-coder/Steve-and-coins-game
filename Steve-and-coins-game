  skels.forEach(drawSkel);
  arrows.forEach(drawArrow);
  playerArrows.forEach(drawArrow);
  if(dragon)drawDragon();
  drawSteve();
  fx.forEach(f=>R(f.x,f.y,5,5,f.c));
  g.restore();
  hint();
}
function overlay(a,b){
  g.fillStyle='rgba(0,0,0,.55)';g.fillRect(0,0,W,H);
  g.fillStyle='#fff';g.textAlign='center';
  g.font='bold 38px "Trebuchet MS",sans-serif';g.fillText(a,W/2,170);
  g.font='22px "Trebuchet MS",sans-serif';g.fillText(b,W/2,220);
}
let gameError='';
function loop(now){
  const dt=Math.min((now-last)/1000,.05);last=now;
  try{if(state==='play')update(dt);}catch(err){
    console.error('Ошибка игрового цикла:',err);
    gameError=err&&err.message?err.message:'Неизвестная ошибка';
    state='error';keys.l=keys.r=keys.j=keys.b=0;
  }
  if(s){
    const tx=s.x+16-W/2+(mx-W/2)*set.sens/100*.8;
    cam+=(tx-cam)*Math.min(1,dt*8);cam=Math.max(0,Math.min(WW-W,cam));
  }
  draw(now/1000);
  const nm=level===0?'Обучение':'Уровень '+level;
  if(state==='level'){if(level>=50){g.fillStyle='#b00016';g.fillRect(0,0,W,H);g.fillStyle='#fff';g.textAlign='center';g.font='bold 42px sans-serif';g.fillText('ПОБЕДА!',W/2,155);g.font='24px sans-serif';g.fillText('Ты победил Дракона Края!',W/2,205);g.fillText('Пройдены все 50 уровней!',W/2,245)}else overlay(nm+' пройден!','Награда: '+REWARDS[level]+' изумрудов • Пробел или клик — дальше')}
  if(state==='over')overlay('Жизни кончились','Пробел или клик — попробовать снова');
  if(state==='pause')overlay('Пауза','Esc или клик — продолжить, Q — в меню уровней');
  if(state==='error')overlay('Ошибка игры',gameError+' — обнови страницу');
  requestAnimationFrame(loop);
}
function proceed(){
  if(state==='level'){level>=50?showMenu('levels'):startLevel(level+1)}
  else if(state==='over')startLevel(level);
  else if(state==='pause')state='play';
}
function press(k,v){keys[k]=v;if(k==='j'&&v)proceed();if(k==='a'&&v){if(state==='play')attack();else proceed()}}
let levelPage=0;
function buildLevels(){
  const lg=$('lg');lg.innerHTML='';
  const first=levelPage*10+1,last=Math.min(first+9,50);
  for(let i=first;i<=last;i++){
    const b=document.createElement('button');b.className='mb';
    const open=i<=unlocked;
    b.textContent=open?i:'🔒';b.disabled=!open;
    b.setAttribute('aria-label','Уровень '+i+(open?'':' закрыт'));
    b.onclick=()=>{pendingLevel=i;$('timeChoice').style.display='block';};lg.appendChild(b);
  }
  $('pageLabel').textContent=first+'–'+last;
  $('bPrevPage').disabled=levelPage===0;
  $('bNextPage').disabled=levelPage===4;
}
function showMenu(screen){
  state='menu';$('menu').classList.remove('off');keys.l=keys.r=keys.j=keys.b=0;
  ['main','levels','shop','settings','keys','chars','bye'].forEach(id=>$(id).style.display=id===screen||(!screen&&id==='main')?'flex':'none');
  if(screen==='levels'){$('timeChoice').style.display='none';buildLevels();}
  if(screen==='keys')buildKeys();
  if(screen==='chars')buildChars();
}
$('bplay').onclick=()=>showMenu('levels');
$('bTutorial').onclick=()=>{pendingLevel=0;$('timeChoice').style.display='block';};
$('bPrevPage').onclick=()=>{if(levelPage>0){levelPage--;buildLevels();}};
$('bNextPage').onclick=()=>{if(levelPage<4){levelPage++;buildLevels();}};
$('bshop').onclick=()=>{buildShop();showMenu('shop')};
$('bbackShop').onclick=()=>showMenu('main');
$('bday').onclick=()=>{worldTime='day';startLevel(pendingLevel)};
$('bnight').onclick=()=>{worldTime='night';startLevel(pendingLevel)};
$('bset').onclick=()=>showMenu('settings');
$('bback1').onclick=()=>showMenu('main');
$('bback2').onclick=()=>showMenu('main');
$('bchar').onclick=()=>showMenu('chars');
$('bback5').onclick=()=>showMenu('settings');
$('bkeys').onclick=()=>showMenu('keys');
$('bback3').onclick=()=>showMenu('settings');
$('bkreset').onclick=()=>{binds=Object.assign({},DEF);saveKeys();rebuild();buildKeys()};
$('bexit').onclick=()=>{try{window.close()}catch(e){}showMenu('bye')};
$('bback4').onclick=()=>showMenu('main');
const DEF={l:'KeyA',r:'KeyD',j:'Space',a:'KeyF',b:'ShiftLeft',bow:'KeyR'};
const NAMES={l:'Влево',r:'Вправо',j:'Прыжок',a:'Удар мечом',b:'Щит',bow:'Выстрел из лука'};
let binds=Object.assign({},DEF),map={},waiting=null;
try{Object.assign(binds,JSON.parse(localStorage.getItem('steveKeys')||'{}'))}catch(e){}
function saveKeys(){try{localStorage.setItem('steveKeys',JSON.stringify(binds))}catch(e){}}
function rebuild(){map={ArrowLeft:'l',ArrowRight:'r',ArrowUp:'j',KeyW:'j',KeyE:'b'};for(const k in binds)map[binds[k]]=k}
rebuild();
function keyName(c){
  if(c==='Space')return 'Пробел';
  if(c.startsWith('Key'))return c.slice(3);
  if(c.startsWith('Digit'))return c.slice(5);
  const m={ArrowLeft:'←',ArrowRight:'→',ArrowUp:'↑',ArrowDown:'↓',ShiftLeft:'Shift',ShiftRight:'Shift'};
  return m[c]||c;
}
function buildKeys(){
  const kg=$('kg');kg.innerHTML='';
  for(const a in NAMES){
    const l=document.createElement('span');l.textContent=NAMES[a];
    const b=document.createElement('button');b.className='mb';
    b.textContent=waiting===a?'Нажми клавишу…':keyName(binds[a]);
    b.onclick=()=>{waiting=a;buildKeys()};
    kg.append(l,b);
  }
}
addEventListener('keydown',e=>{
  if(waiting){
    e.preventDefault();
    if(e.code!=='Escape'){
      for(const a in binds)if(binds[a]===e.code&&a!==waiting)binds[a]=binds[waiting];
      binds[waiting]=e.code;saveKeys();rebuild();
    }
    waiting=null;buildKeys();return;
  }
  if(e.code==='Escape'){
    if(state==='play'){state='pause';keys.l=keys.r=keys.j=keys.b=0}
    else if(state==='pause')state='play';
    else if(state==='level'||state==='over')showMenu('levels');
    else if(state==='error')showMenu('main');
    return;
  }
  if(e.code==='KeyQ'&&state==='pause'){showMenu('levels');return}
  if(state==='pause')return;
  if(state==='menu')return;
  if(map[e.code]){e.preventDefault();if(map[e.code]==='bow')fireBow();else press(map[e.code],1)}
});
addEventListener('keyup',e=>{if(map[e.code])press(map[e.code],0)});
cv.addEventListener('mousemove',e=>{const r=cv.getBoundingClientRect();mx=(e.clientX-r.left)*W/r.width});
cv.addEventListener('contextmenu',e=>e.preventDefault());
addEventListener('mouseup',e=>{if(e.button===2)keys.b=0});
cv.addEventListener('mousedown',e=>{
  if(e.button===2){e.preventDefault();keys.b=1;return}
  if(e.button!==0)return;e.preventDefault();
  if(state!=='play'){proceed();return}
  const r=cv.getBoundingClientRect();mx=(e.clientX-r.left)*W/r.width;
  s.dir=(mx+cam)>s.x+16?1:-1;attack();
});
[['bl','l'],['br','r'],['bj','j'],['bs','b']].forEach(([id,k])=>{
  const b=$(id);
  b.addEventListener('pointerdown',e=>{e.preventDefault();press(k,1)});
  ['pointerup','pointerleave','pointercancel'].forEach(ev=>b.addEventListener(ev,()=>press(k,0)));
});
$('bp').addEventListener('pointerdown',e=>{e.preventDefault();if(state==='play')state='pause';else if(state==='pause')state='play'});
$('ba').addEventListener('pointerdown',e=>{e.preventDefault();if(state!=='play')proceed();else attack()});
$('bBow').addEventListener('pointerdown',e=>{e.preventDefault();fireBow()});
saveInventory();startLevel(0);showMenu('main');
requestAnimationFrame(loop);
</script>
</body>
