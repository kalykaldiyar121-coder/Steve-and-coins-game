      c.strokeStyle=SKIN;c.lineWidth=0.115;c.beginPath();c.moveTo(mx,my);c.lineTo(hx,hy);c.stroke();
      c.strokeStyle=TEE1;c.lineWidth=0.17;c.beginPath();c.moveTo(sx,sy);c.lineTo(mx,my);c.stroke();
      c.fillStyle=SKIN;c.beginPath();c.arc(hx,hy,0.06,0,Math.PI*2);c.fill();
    }
  }
  if(back)arms();
  /* torso */
  c.save();rr(c,-0.27,-1.14,0.54,0.6,0.1);c.clip();
  for(var s=0;s<8;s++){c.fillStyle=s%2?TEE2:TEE1;c.fillRect(-0.3,-1.16+s*0.08,0.6,0.08);}
  if(back){c.fillStyle='rgba(0,0,0,0.12)';c.fillRect(-0.02,-1.14,0.04,0.6);}
  c.restore();
  if(!back)arms();
  /* neck + head */
  c.fillStyle=SKIN;c.fillRect(-0.075,-1.2,0.15,0.1);
  var hx0=0,hy0=-1.4,hr=0.27;
  c.fillStyle=SKIN;c.beginPath();c.ellipse(-hr,hy0+0.02,0.05,0.065,0,0,Math.PI*2);c.ellipse(hr,hy0+0.02,0.05,0.065,0,0,Math.PI*2);c.fill();
  if(back){
    c.fillStyle=HAIR;c.beginPath();c.arc(hx0,hy0,hr,0,Math.PI*2);c.fill();
    c.fillStyle=SKIN;c.beginPath();c.ellipse(0,hy0+0.2,0.1,0.05,0,0,Math.PI);c.fill();
    c.fillStyle='rgba(255,255,255,0.08)';c.beginPath();c.ellipse(-0.08,hy0-0.12,0.1,0.05,-0.4,0,Math.PI*2);c.fill();
    c.strokeStyle=FRAME;c.lineWidth=0.03;c.lineCap='round';
    c.beginPath();c.moveTo(-hr-0.01,hy0-0.02);c.lineTo(-hr-0.04,hy0+0.02);c.moveTo(hr+0.01,hy0-0.02);c.lineTo(hr+0.04,hy0+0.02);c.stroke();
  }else{
    c.fillStyle=SKIN;c.beginPath();c.arc(hx0,hy0,hr,0,Math.PI*2);c.fill();
    c.fillStyle=HAIR;c.beginPath();c.arc(hx0,hy0,hr+0.012,Math.PI*1.03,Math.PI*1.97);
    c.quadraticCurveTo(0.12,hy0-0.13,0,hy0-0.115);c.quadraticCurveTo(-0.12,hy0-0.1,-0.26,hy0-0.045);c.closePath();c.fill();
    c.strokeStyle=FRAME;c.lineWidth=0.032;
    rr(c,-0.205,hy0-0.065,0.17,0.115,0.03);c.fillStyle='rgba(230,245,255,0.35)';c.fill();c.stroke();
    rr(c,0.035,hy0-0.065,0.17,0.115,0.03);c.fill();c.stroke();
    c.beginPath();c.moveTo(-0.035,hy0-0.025);c.lineTo(0.035,hy0-0.025);c.moveTo(-0.205,hy0-0.03);c.lineTo(-hr,hy0-0.02);c.moveTo(0.205,hy0-0.03);c.lineTo(hr,hy0-0.02);c.stroke();
    c.fillStyle=HAIR;c.beginPath();c.arc(-0.12,hy0-0.01,0.017,0,Math.PI*2);c.arc(0.12,hy0-0.01,0.017,0,Math.PI*2);c.fill();
    c.strokeStyle=SKIND;c.lineWidth=0.022;c.beginPath();c.moveTo(0,hy0+0.02);c.lineTo(-0.012,hy0+0.07);c.lineTo(0.012,hy0+0.075);c.stroke();
    c.strokeStyle='#7d4a3a';c.lineWidth=0.024;c.beginPath();c.moveTo(-0.07,hy0+0.14);c.quadraticCurveTo(0,hy0+0.17,0.07,hy0+0.14);c.stroke();
  }
  if(sk.hat){
    c.fillStyle=sk.hat;c.beginPath();c.arc(hx0,hy0-0.08,hr+0.02,Math.PI,Math.PI*2);c.closePath();c.fill();
    c.fillStyle='rgba(0,0,0,0.22)';
    if(back){c.fillRect(-hr-0.02,hy0-0.1,2*hr+0.04,0.03);}
    else{c.beginPath();c.ellipse(0,hy0-0.075,0.32,0.05,0,0,Math.PI*2);c.fill();c.fillStyle=sk.hat;c.beginPath();c.ellipse(0,hy0-0.09,0.31,0.045,0,0,Math.PI*2);c.fill();}
  }
  c.restore();
}

/* ---------- world drawing ---------- */
function hash(n){var s=Math.sin(n*127.1+311.7)*43758.5453;return s-Math.floor(s);}
function mount(amp,color,off,fr,ph){
  ctx.beginPath();ctx.moveTo(0,HOR+2);
  for(var x=0;x<=W;x+=6){var t=(x+off)*fr;var y=HOR-amp*(0.5+0.32*Math.sin(t+ph)+0.2*Math.sin(t*2.3+1.7+ph)+0.1*Math.sin(t*5.1+0.4));ctx.lineTo(x,Math.min(HOR+2,y));}
  ctx.lineTo(W,HOR+2);ctx.closePath();ctx.fillStyle=color;ctx.fill();
}
function drawBackdrop(){
  var g=ctx.createLinearGradient(0,0,0,HOR);g.addColorStop(0,'#7ec3d6');g.addColorStop(0.7,'#cfe6d9');g.addColorStop(1,'#f0e0bc');
  ctx.fillStyle=g;ctx.fillRect(0,0,W,HOR+2);
  ctx.fillStyle='rgba(255,246,214,0.95)';ctx.beginPath();ctx.arc(W*0.74,HOR*0.5,30,0,Math.PI*2);ctx.fill();
  ctx.fillStyle='rgba(255,246,214,0.25)';ctx.beginPath();ctx.arc(W*0.74,HOR*0.5,52,0,Math.PI*2);ctx.fill();
  mount(90,'#9ebdb4',dist*0.4,0.012,0.5);
  mount(60,'#7da79d',dist*0.9,0.019,2.1);
  mount(30,'#5e8f84',dist*1.6,0.03,4.3);
  var gg=ctx.createLinearGradient(0,HOR,0,H);gg.addColorStop(0,'#cdd9a8');gg.addColorStop(0.25,'#6d9a5e');gg.addColorStop(1,'#2f5a40');
  ctx.fillStyle=gg;ctx.fillRect(0,HOR,W,H-HOR);
}
function drawRoad(){
  var e=1.5*LW, zf=75;
  poly([P(-e-0.25,0,ZN),P(e+0.25,0,ZN),P(e+0.25,0,zf),P(-e-0.25,0,zf)],[134,126,108],0);
  poly([P(-e,0,ZN),P(e,0,ZN),P(e,0,zf),P(-e,0,zf)],[222,196,148],0);
  var k0=Math.floor(dist/2);
  for(var k=k0+38;k>=k0;k--){
    var rel=k*2-dist; if(rel+0.14<ZN)continue; curFog=fogOf(rel);
    var a=Math.max(rel,ZN);
    poly([P(-e,0,a),P(e,0,a),P(e,0,rel+0.14),P(-e,0,rel+0.14)],[196,166,116]);
  }
  curFog=0.15;
  [-0.5*LW,0.5*LW].forEach(function(x){poly([P(x-0.025,0,ZN),P(x+0.025,0,ZN),P(x+0.025,0,zf),P(x-0.025,0,zf)],[246,236,208]);});
  curFog=0.1;
  [-e-0.12,e+0.12].forEach(function(x){poly([P(x-0.12,0,ZN),P(x+0.12,0,ZN),P(x+0.12,0,zf),P(x-0.12,0,zf)],[150,152,142]);});
  var hz=ctx.createLinearGradient(0,HOR,0,HOR+90);hz.addColorStop(0,'rgba(240,224,188,1)');hz.addColorStop(1,'rgba(240,224,188,0)');
  ctx.fillStyle=hz;ctx.fillRect(0,HOR,W,90);
}
function drawScenery(){
  var k0=Math.ceil((dist-3)/5);
  for(var k=k0+17;k>=k0;k--){
    var z=k*5-dist; if(z<ZN+0.2)continue; curFog=fogOf(z);
    for(var sd=-1;sd<=1;sd+=2){
      var r=hash(k*3+sd+7); if(r<0.3)continue;
      var x=sd*(2.7+hash(k*5+sd)*3.4), b=P(x,0,z), s=b[2];
      if(r>0.9){
        box(x-0.3,x+0.3,0,2.3,z,z+0.6,STONE[0],STONE[1],STONE[2]);
      }else{
        var tv=0.8+hash(k*11+sd)*0.6;
        ctx.fillStyle=col([96,66,40]);ctx.fillRect(b[0]-0.13*s*tv,b[1]-1.5*s*tv,0.26*s*tv,1.5*s*tv);
        ctx.fillStyle=col([48,112,70]);ctx.beginPath();ctx.arc(b[0],b[1]-2.0*s*tv,1.15*s*tv,0,Math.PI*2);ctx.fill();
        ctx.fillStyle=col([76,148,84]);ctx.beginPath();ctx.arc(b[0]-0.3*s*tv,b[1]-2.25*s*tv,0.75*s*tv,0,Math.PI*2);ctx.fill();
      }
    }
  }
}
function laneX(l){return (l-1)*LW;}
function drawFlat(o){
  var rel=o.z-dist; if(rel+o.len<ZN||rel>80)return; curFog=fogOf(rel);
  var x0=laneX(o.lane)-LW/2+0.02,x1=laneX(o.lane)+LW/2-0.02, a=Math.max(rel,ZN), b=rel+o.len-0.04;
  if(b<=a)return;
  if(o.type==='pit'){
    poly([P(x0,0,a),P(x1,0,a),P(x1,0,b),P(x0,0,b)],WATER);
    var t=performance.now()/500;
    for(var i=0;i<3;i++){var zz=a+(b-a)*((i+0.5+0.3*Math.sin(t+i+o.z))/3.2);if(zz<a||zz>b)continue;seg(P(x0+0.15,0,zz),P(x1-0.15,0,zz),WATER2,Math.max(1,P(0,0,zz)[2]*0.03));}
    seg(P(x0,0,a),P(x1,0,a),[30,80,100],Math.max(1.5,P(0,0,a)[2]*0.05));
  }else{
    poly([P(x0,0,a),P(x1,0,a),P(x1,0,b),P(x0,0,b)],[150,152,142]);
    poly([P(x0+0.06,0,a+0.06),P(x1-0.06,0,a+0.06),P(x1-0.06,0,b-0.06),P(x0+0.06,0,b-0.06)],[176,178,166]);
  }
}
function front(x0,x1,y0,y1,z){return [P(x0,y0,z),P(x1,y0,z),P(x1,y1,z),P(x0,y1,z)];}
function drawSolid(o){
  var rel=o.z-dist; if(rel>80)return; curFog=fogOf(rel);
  var x0=laneX(o.lane)-LW*0.44,x1=laneX(o.lane)+LW*0.44,i;
  if(o.type==='rock'){
    var cl=box(x0+0.08,x1-0.08,0,o.h,rel,rel+o.len,STONE[0],STONE[1],STONE[2]);
    if(!cl&&rel>ZN){var f=front(x0+0.08,x1-0.08,0,o.h,rel);seg([f[0][0]+(f[1][0]-f[0][0])*0.2,f[0][1]+(f[3][1]-f[0][1])*0.2],[f[0][0]+(f[1][0]-f[0][0])*0.45,f[0][1]+(f[3][1]-f[0][1])*0.7],[84,86,82],2);
      seg([f[0][0]+(f[1][0]-f[0][0])*0.7,f[0][1]+(f[3][1]-f[0][1])*0.9],[f[0][0]+(f[1][0]-f[0][0])*0.6,f[0][1]+(f[3][1]-f[0][1])*0.35],[84,86,82],2);}
  }else if(o.type==='log'){
    var cl2=box(x0,x1,0,o.h,rel,rel+o.len,WOOD[0],WOOD[1],WOOD[2]);
    if(!cl2&&rel>ZN){for(i=1;i<4;i++){var yy=o.h*i/4;seg(P(x0+0.05,yy,rel),P(x1-0.05,yy,rel),WOODD[0],Math.max(1,P(0,0,rel)[2]*0.025));}}
  }else if(o.type==='beam'){
    var pw=0.12;
    box(x0,x0+pw,0,1.75,rel,rel+o.len,WOODD[0],WOODD[1],WOODD[2]);
    box(x1-pw,x1,0,1.75,rel,rel+o.len,WOODD[0],WOODD[1],WOODD[2]);
    var cl3=box(x0,x1,1.05,1.42,rel,rel+o.len,WOOD[0],WOOD[1],WOOD[2]);
    if(!cl3&&rel>ZN){var f2=front(x0,x1,1.05,1.42,rel);for(i=0;i<5;i++){var u=(i+0.5)/5;poly([[f2[0][0]+(f2[1][0]-f2[0][0])*(u-0.05),f2[0][1]],[f2[0][0]+(f2[1][0]-f2[0][0])*(u+0.05),f2[0][1]],[f2[0][0]+(f2[1][0]-f2[0][0])*(u+0.05),f2[3][1]],[f2[0][0]+(f2[1][0]-f2[0][0])*(u-0.05),f2[3][1]]],[228,176,60]);}}
  }else if(o.type==='stairs'){
    var dz=rel+o.ramp, cd=box(x0-0.02,x1+0.02,0,o.h,dz,dz+o.deck,WOOD[0],WOOD[1],WOOD[2]);
    var ln=Math.floor(o.deck/1.2);
    for(i=0;i<=ln;i++){var zz=dz+i*1.2;if(zz<ZN+0.05)continue;seg(P(x0-0.02,o.h,zz),P(x1+0.02,o.h,zz),WOODD[0],Math.max(1,P(0,0,zz)[2]*0.02));}
    for(var s=5;s>=0;s--){var h=o.h*(s+1)/6;box(x0-0.02,x1+0.02,0,h,rel+s*o.ramp/6,dz,WOOD[0],WOOD[1],WOOD[2]);}
  }else if(o.type==='coin'){
    if(o.taken||rel<-0.6)return;
    var c=P(laneX(o.lane),o.y+0.8,rel), r=0.3*c[2], an=Math.abs(Math.cos(performance.now()/260+o.z));
    ctx.fillStyle=col([255,201,40]);ctx.strokeStyle=col([176,126,10]);ctx.lineWidth=Math.max(1,r*0.2);
    ctx.beginPath();ctx.ellipse(c[0],c[1],Math.max(1.5,r*an),r,0,0,Math.PI*2);ctx.fill();ctx.stroke();
    ctx.fillStyle=col([255,232,130]);ctx.beginPath();ctx.ellipse(c[0],c[1],Math.max(0.8,r*0.5*an),r*0.5,0,0,Math.PI*2);ctx.fill();
  }
}
function objEnd(o){return o.z-dist+(o.len||0);}

function drawPlayer(){
  curFog=0;
  var lane=laneOf(p.x), gl=groundAt(lane,dist);
  if(gl!==-Infinity){var sp=P(p.x,gl,0);ctx.fillStyle='rgba(0,0,0,0.28)';var sc=Math.max(0.35,1-(p.y-gl)*0.18);ctx.beginPath();ctx.ellipse(sp[0],sp[1],sp[2]*0.38*sc,sp[2]*0.11*sc,0,0,Math.PI*2);ctx.fill();}
  var b=P(p.x,p.y,0), k=b[2]*0.98;
  var pose=p.slide>0?'slide':(p.grounded?'run':'jump');
  var tilt=state==='dead'&&deadWhy!=='water'?Math.min(deadT*4,1.35)*(p.x>=0?-1:1):0;
  if(state==='dead'&&deadWhy!=='water')pose='run';
  ctx.save();
  if(state==='dead'&&deadWhy==='water'){ctx.beginPath();ctx.rect(0,0,W,P(0,0,0)[1]+4);ctx.clip();}
  drawAudi(ctx,b[0],b[1],k,{view:'back',phase:state==='dead'?0:p.phase,pose:state==='menu'?'run':pose,tilt:tilt});
  ctx.restore();
  if(state==='menu'||runT<3.2){
    var a=state==='menu'?1:Math.max(0,Math.min(1,(3.2-runT)));
    ctx.save();ctx.globalAlpha=a;ctx.font='22px "Lilita One","Trebuchet MS",sans-serif';var tw=ctx.measureText('Audi').width;
    var tx=b[0],ty=b[1]-1.95*k;
    ctx.fillStyle='#ffc928';rr(ctx,tx-tw/2-10,ty-20,tw+20,28,10);ctx.fill();
    ctx.fillStyle='#0e1c20';ctx.textAlign='center';ctx.fillText('Audi',tx,ty);ctx.restore();
  }
}
function drawHUD(){
  ctx.save();ctx.textBaseline='top';
  ctx.font='34px "Lilita One","Trebuchet MS",sans-serif';ctx.lineWidth=5;ctx.lineJoin='round';
  var m=Math.floor(dist)+' м';
  ctx.textAlign='left';ctx.strokeStyle='#0e1c20';ctx.fillStyle='#f7efdc';ctx.strokeText(m,14,12);ctx.fillText(m,14,12);
  ctx.textAlign='right';var cs=String(coins);ctx.strokeText(cs,W-46,12);ctx.fillText(cs,W-46,12);
  ctx.fillStyle='#ffc928';ctx.strokeStyle='#b07d08';ctx.lineWidth=3;ctx.beginPath();ctx.arc(W-26,31,13,0,Math.PI*2);ctx.fill();ctx.stroke();
  ctx.fillStyle='#ffe682';ctx.beginPath();ctx.arc(W-26,31,6,0,Math.PI*2);ctx.fill();
  ctx.font='16px "Lilita One","Trebuchet MS",sans-serif';ctx.textAlign='left';ctx.lineWidth=4;ctx.strokeStyle='#0e1c20';ctx.fillStyle='#f7efdc';
  var bt='рекорд '+Math.max(best,Math.floor(dist));ctx.strokeText(bt,16,52);ctx.fillText(bt,16,52);
  ctx.restore();
}

function render(){
  ctx.clearRect(0,0,W,H);
  drawBackdrop();drawRoad();drawScenery();
  var flats=[],before=[],after=[];
  for(var i=0;i<objs.length;i++){
    var o=objs[i],rel=o.z-dist;
    if(rel>80||objEnd(o)+(o.ramp||0)<ZN-1)continue;
    if(o.type==='pit'||o.type==='tile')flats.push(o);
    else if(objEnd(o)+(o.ramp?0:0)>0.2||o.type==='stairs'&&rel+o.len>0.2)before.push(o);
    else after.push(o);
  }
  flats.sort(function(a,b){return b.z-a.z;});
  before.sort(function(a,b){return b.z-a.z;});
  after.sort(function(a,b){return b.z-a.z;});
  flats.forEach(drawFlat);
  before.forEach(drawSolid);
  drawPlayer();
  after.forEach(drawSolid);
  drawHUD();
}

/* ---------- UI ---------- */
var startOv=document.getElementById('startOv'),overOv=document.getElementById('overOv');
function showOver(){
  var d=Math.floor(dist);
  if(d>best){best=d;try{localStorage.setItem('audi-run-best',String(best));}catch(e){}}
  document.getElementById('overTitle').textContent=deadWhy==='water'?'Audi упал в воду!':'Audi врезался!';
  document.getElementById('sDist').textContent=d;
  document.getElementById('sCoins').textContent=coins;
  document.getElementById('sBest').textContent=best;
  overOv.hidden=false;
  setTimeout(function(){try{document.getElementById('againBtn').focus({preventScroll:true});}catch(e){}},50);
}
function startGame(){
  reset();state='play';startOv.hidden=true;overOv.hidden=true;
  tone(440,880,0.15,'triangle',0.06);
}
document.getElementById('playBtn').addEventListener('click',startGame);
document.getElementById('againBtn').addEventListener('click',startGame);

function goLeft(){if(state==='play'&&p.lane>0){p.lane--;tone(300,260,0.06,'triangle',0.04);}}
function goRight(){if(state==='play'&&p.lane<2){p.lane++;tone(300,260,0.06,'triangle',0.04);}}
function jump(){if(state==='play'&&p.grounded){p.vy=JUMP;p.grounded=false;p.slide=0;tone(300,700,0.18,'sine',0.07);}}
function slide(){if(state!=='play')return;p.slide=0.7;if(!p.grounded){p.vy=Math.min(p.vy,-15);}tone(260,120,0.18,'triangle',0.06);}
window.addEventListener('keydown',function(e){
  var k=e.key;
  if(state!=='play'){
    if(e.target&&e.target.tagName==='BUTTON')return;
    if((k==='Enter'||k===' ')&&(!startOv.hidden||!overOv.hidden)){e.preventDefault();startGame();}
    return;
  }
  if(k==='ArrowLeft'||k==='a'||k==='A'){goLeft();e.preventDefault();}
  else if(k==='ArrowRight'||k==='d'||k==='D'){goRight();e.preventDefault();}
  else if(k==='ArrowUp'||k==='w'||k==='W'||k===' '){jump();e.preventDefault();}
  else if(k==='ArrowDown'||k==='s'||k==='S'){slide();e.preventDefault();}
});
var sx0=0,sy0=0,sdone=false,sid=null;
var stage=document.getElementById('stage');
stage.addEventListener('pointerdown',function(e){if(e.target.closest('button'))return;sid=e.pointerId;sx0=e.clientX;sy0=e.clientY;sdone=false;});
stage.addEventListener('pointermove',function(e){
  if(e.pointerId!==sid||sdone)return;
  var dx=e.clientX-sx0,dy=e.clientY-sy0;
  if(Math.max(Math.abs(dx),Math.abs(dy))<28)return;
  sdone=true;
  if(Math.abs(dx)>Math.abs(dy)){dx<0?goLeft():goRight();}else{dy<0?jump():slide();}
});
stage.addEventListener('pointerup',function(e){if(e.pointerId===sid&&!sdone&&state==='play')jump();sid=null;});
stage.addEventListener('pointercancel',function(){sid=null;});

/* portrait on the start card */
function drawPortrait(){
  var pc=document.getElementById('portrait'),c=pc.getContext('2d');
  c.clearRect(0,0,pc.width,pc.height);
  c.fillStyle='rgba(31,143,163,0.14)';c.beginPath();c.ellipse(140,352,90,16,0,0,Math.PI*2);c.fill();
  drawAudi(c,140,350,190,{view:'front',pose:'idle',phase:0});
}
drawPortrait();

/* settings menu */
var setOv=document.getElementById('setOv'), setFrom=startOv, skinGrid=document.getElementById('skinGrid'), sndBtn=document.getElementById('sndBtn');
function renderSkins(){
  skinGrid.innerHTML='';
  SKINS.forEach(function(s){
    var b=document.createElement('button');
    b.type='button';b.className='skin';b.setAttribute('aria-pressed',s===curSkin?'true':'false');b.setAttribute('aria-label','Скин '+s.name);
    var cn=document.createElement('canvas');cn.width=220;cn.height=300;
    var c=cn.getContext('2d');
    c.fillStyle='rgba(14,28,32,0.10)';c.beginPath();c.ellipse(110,284,62,10,0,0,Math.PI*2);c.fill();
    drawAudi(c,110,282,156,{view:'front',pose:'idle',phase:0,skin:s});
    var nm=document.createElement('b');nm.textContent=s.name;
    var st=document.createElement('small');st.textContent=s===curSkin?'Выбран':'Выбрать';
    b.appendChild(cn);b.appendChild(nm);b.appendChild(st);
    b.addEventListener('click',function(){curSkin=s;savePref('audi-run-skin',s.id);renderSkins();drawPortrait();tone(500,800,0.1,'triangle',0.05);});
    skinGrid.appendChild(b);
  });
  sndBtn.textContent=soundOn?'Вкл':'Выкл';sndBtn.setAttribute('aria-pressed',soundOn?'true':'false');
}
function openSettings(from){setFrom=from;from.hidden=true;setOv.hidden=false;renderSkins();}
document.getElementById('setBtn1').addEventListener('click',function(){openSettings(startOv);});
document.getElementById('setBtn2').addEventListener('click',function(){openSettings(overOv);});
document.getElementById('setBack').addEventListener('click',function(){setOv.hidden=true;setFrom.hidden=false;});
sndBtn.addEventListener('click',function(){soundOn=!soundOn;savePref('audi-run-sound',soundOn?'on':'off');renderSkins();tone(600,900,0.1,'triangle',0.05);});

/* ---------- loop ---------- */
var last=0;
function frame(t){
  var dt=Math.min(0.05,(t-last)/1000||0);last=t;
  update(dt);render();
  requestAnimationFrame(frame);
}
document.addEventListener('visibilitychange',function(){last=performance.now();});
requestAnimationFrame(function(t){last=t;frame(t);});
})();
</script>
</body>
</html>
